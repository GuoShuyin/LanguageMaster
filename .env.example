# LanguageMaster 环境变量配置
# 复制此文件为 .env 并填入你的 API keys

# Claude API Key (必须 - 用于日文注音 furigana 和中文翻译)
# 从 https://console.anthropic.com 获取
CLAUDE_API_KEY=

# Claude 模型名称
CLAUDE_MODEL=claude-sonnet-4-20250514

# OpenAI API Key (可选 - 仅无字幕视频需要，用于 Whisper 语音转文字)
# 从 https://platform.openai.com 获取
OPENAI_API_KEY=

# 服务器端口 (可选)
PORT=3001
